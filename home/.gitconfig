[alias]
  cpr = pull-request
  sp = smart-pull
  commit = ci
  ci = commit
  co = checkout
  st = status
  info = status
  svn-diff = !git-svn-diff
  l = log --graph --pretty=format':%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset'
  lol = log --pretty=oneline --abbrev-commit --graph --decorate
  unstage = reset HEAD
  staged = diff --cached
  unstaged = diff
  current-branch = !git symbolic-ref -q HEAD | sed -e 's|^refs/heads/||'
  tag = tag -as

[apply]
  whitespace = warn

[color]
  diff = auto
  status = auto
  branch = auto
  ui = true

[help]
  autocorrect = 1

[status]
  submodule = 1

[push]
  default = current

[core]
  excludesfile = /home/xentek/.gitignore
  editor = vim
  whitespace = trailing-space,space-before-tab
  trustctime = false

[credential]
  credentialStore = secretservice
  helper = git-credential-manager
	helper = 
	helper = /usr/local/bin/git-credential-manager

[credential "https://dev.azure.com"]
  useHttpPath = true

[gpg]
  program = gpg

[commit]
  gpgsign = true

[init]
  defaultBranch = main

[pull]
	rebase = false

[user]
  name = "Eric Marden"
  email = eric.marden@gmail.com
  signingkey = 2F3784334AEC316E

[github]
    user = xentek

[credential "https://github.com"]
  username = xentek
